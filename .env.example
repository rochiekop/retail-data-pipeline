# Copy this file to .env and set your own values. .env is git-ignored: never commit it.
# docker compose reads .env for the containers, and src/pipeline/config.py loads it for host-side Python and dbt.

# Shop Database (Postgres). SHOP_DB_PORT is the port published on the host.
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=change-me
SHOP_DB_NAME=shop
SHOP_DB_PORT=5433

# Warehouse (ClickHouse): the same user exists in warehouse and warehouse-test. WAREHOUSE_PORT is the host port.
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change-me
WAREHOUSE_PORT=8123

# Airflow metadata database (Postgres). Use letters, digits, - and _ only: it goes into a connection URL.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
